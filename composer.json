{
    "name": "openbarcode/openbarcode",
    "description": "Open Barcode: linear barcode generation for PHP (Code 39, EAN-13, UPC-A) with no runtime dependencies.",
    "type": "library",
    "license": "Apache-2.0",
    "homepage": "https://openbarcode.dev",
    "keywords": ["barcode", "ean", "upc", "code39", "linear"],
    "support": {
        "source": "https://github.com/openbarcode/php",
        "issues": "https://github.com/openbarcode/php/issues"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "OpenBarcode\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenBarcode\\Tests\\": "tests/"
        }
    }
}
